{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "apps/client/src/wasm/**",
    "**/dist/**",
    "target/**",
    "node_modules/**",
    ".agents/**",
    ".claude/**"
  ],
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "eslint/no-underscore-dangle": [
      "warn",
      {
        "allow": ["__shifty"]
      }
    ],
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["apps/client/src/**"],
      "rules": {
        "eslint/no-restricted-properties": [
          "error",
          {
            "object": "location",
            "property": "search",
            "message": "URL switches are dev-only: read them from devParams (dev-params.ts)."
          },
          {
            "property": "searchParams",
            "message": "URL switches are dev-only: read them from devParams (dev-params.ts)."
          }
        ]
      }
    }
  ]
}
