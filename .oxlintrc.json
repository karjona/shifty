{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["apps/client/src/wasm/**", "**/dist/**", "target/**", "node_modules/**"],
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "eslint/no-underscore-dangle": [
      "warn",
      {
        "allow": ["__shifty"]
      }
    ]
  }
}
