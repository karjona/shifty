{
  "name": "shifty",
  "version": "0.9.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build:wasm": "node scripts/build-wasm.ts",
    "build": "pnpm build:wasm && pnpm --filter client build",
    "check:determinism": "node scripts/check-determinism.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc -p apps/client && tsc -p apps/lobby && tsc -p packages/rider && tsc -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
